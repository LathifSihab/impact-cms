# IMPACT backoffice — variable names only. No values, ever, in the repo.
#
# Same principle as the site: nothing that identifies an account is hardcoded, so
# handover is editing boxes in a UI rather than a code change and a redeploy.
#
# One thing this project has already been bitten by twice: a value set in a
# hosting UI reaches the running app only after a new deploy. Changing it in
# Vercel and refreshing the page changes nothing.

# ---- Supabase ---------------------------------------------------------------
# Project URL and anon key are public by design — RLS is what protects the data,
# and every policy here requires an authenticated user.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS entirely. Used by scripts/seed.ts and scripts/create-user.ts and
# by nothing in the app. Never expose it to the browser, never put it in Vercel's
# public variables.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Signalen (read-only) ---------------------------------------------------
# The joined view reads these. Leave them empty and the page says so plainly
# instead of showing an empty table that looks like "no signups".
#
# Brevo: lists 3 = Newsletter, 4 = Waitlist. Segmentation is carried on contact
# attributes, not tags — tags are silently discarded on this account.
BREVO_API_KEY=

# Ticket Tailor: HTTP Basic, the API key as the username with an empty password.
TICKET_TAILOR_API_KEY=
