# IMPACT backoffice — variable names only. No values, ever, in the repo.
#
# Same principle as the site: nothing that identifies an account is hardcoded, so
# handover is editing boxes in a UI rather than a code change and a redeploy.
#
# One thing this project has already been bitten by twice: a value set in a
# hosting UI reaches the running app only after a new deploy. Changing it in
# Vercel and refreshing the page changes nothing.

# ---- Supabase ---------------------------------------------------------------
# Project URL and anon key are public by design — RLS is what protects the data,
# and every policy here requires an authenticated user.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS entirely. Used by scripts/seed.ts and scripts/create-user.ts and
# by nothing in the app. Never expose it to the browser, never put it in Vercel's
# public variables.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Signalen (read-only) ---------------------------------------------------
# The joined view reads these. Leave them empty and the page says so plainly
# instead of showing an empty table that looks like "no signups".
#
# Brevo: lists 3 = Newsletter, 4 = Waitlist. Segmentation is carried on contact
# attributes, not tags — tags are silently discarded on this account.
BREVO_API_KEY=

# Which Brevo list a signup joins. 3 = Newsletter, 4 = Waitlist on the current
# account. Without them a contact is still created and still carries its
# attributes, it just is not on a list — which is easy to miss.
BREVO_LIST_NEWSLETTER=
BREVO_LIST_WAITLIST=

# Set a template id and newsletter signups use double opt-in instead of
# subscribing directly. Never for the waiting list: that consent was given
# explicitly by an adult on a form that will not submit without the tick, and a
# second confirmation there costs signups without adding a record we do not hold.
BREVO_DOI_TEMPLATE_ID=
BREVO_DOI_REDIRECT=

# Ticket Tailor: HTTP Basic, the API key as the username with an empty password.
TICKET_TAILOR_API_KEY=

# ---- the rendered public site ------------------------------------------------
# The CMS renders /events and /journal itself. These three are read at request
# time, unlike the static site's build-time equivalents.

# Canonical origin, used for the sitemap. Falls back to the request origin.
PUBLIC_SITE_URL=

# Where the forms post. Defaults to this app's own /api/subscribe, which is
# what you want. It exists as an override for a deployment that has to post
# somewhere else; it used to be required, because the endpoint lived in the
# static site's repository before that site was retired.
PUBLIC_SUBSCRIBE_ENDPOINT=

# Ticket Tailor box office, linked from editions whose status is `open`.
PUBLIC_TICKET_TAILOR_BOX_OFFICE=

# Fallback for a page slug that is not configured in the backoffice yet. All
# eleven current pages are, so this never fires — leave it empty now that the
# static build is retired, and an unconfigured slug 404s here honestly instead
# of pointing at a site that is no longer maintained.
PUBLIC_STATIC_SITE_BASE=https://demo-impact-c399e3.netlify.app

# ---- File storage -----------------------------------------------------------
# The bucket uploaded images live in. Set this and uploads go to Supabase
# Storage; leave it empty and they go to a folder on disk.
#
# On Vercel it is not optional. That filesystem is read-only and ephemeral: a
# file written by an upload is gone on the next invocation, so every image 404s
# within minutes of a deploy. The bucket must be public — the pages link
# straight at it so images come off the CDN rather than through a function on
# every request. Writes still need the service-role key, which the browser
# never sees.
PUBLIC_SUPABASE_STORAGE_BUCKET=

# Force a backend regardless of the above: "disk" or "supabase". Only useful for
# local work; leave it unset everywhere else.
UPLOAD_BACKEND=

# Where the disk backend writes, if you use it. Defaults to cms/uploads.
UPLOAD_DIR=

# ---- analytics — Plausible ---------------------------------------------------
# The dashboard's traffic panel. Both are needed; with either missing the panel
# says so and the rest of the screen still works.
#
# The Stats API is plan-gated — it is not on every Plausible tier. If the panel
# reports that Plausible refused access, that is what it means, and the options
# are to upgrade or to link out to the Plausible dashboard instead.
#
# The attribution half of that panel needs neither of these: it reads our own
# subscriptions table, which records the page, referrer and campaign of every
# signup since the form endpoint came in-house.
# The tracking side. The domain is the site name as Plausible knows it, and
# _SRC is the script Plausible gives you — the modern one carries a site id in
# its filename, so it is not the same URL for every account. Without the domain
# analytics.js loads nothing at all.
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_SRC=

# The reading side, for the dashboard's traffic panel. A separate credential
# from the script above: Plausible → Settings → API keys.
PLAUSIBLE_API_KEY=
